# Project V.A.R.U.N.A. Environment Configuration Template
DATABASE_URL=postgresql://varuna_user:varuna_secure_password@db/varuna_db
REDIS_URL=redis://redis:6379/0

# Application
SECRET_KEY=varuna-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Map Tile Provider (CartoDB / Stadia Maps)
NEXT_PUBLIC_MAP_KEY=YOUR_MAP_KEY_HERE

# ML Pipeline
ESRGAN_MODEL_PATH=./ml_pipeline/super_resolution/weights/esrgan.pth
UNET_MODEL_PATH=./ml_pipeline/segmentation/weights/unet.pth
