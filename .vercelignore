# NOTE: do NOT exclude backend/ or requirements.txt here.
# Vercel's Python runtime needs backend/app/*.py to find the FastAPI
# entrypoint (api/index.py -> backend/app/main.py) and needs
# requirements.txt to install dependencies.
scratch/
__pycache__/
*.pyc
node_modules/
frontend/node_modules/
.git/
docker-compose.yml
render.yaml
